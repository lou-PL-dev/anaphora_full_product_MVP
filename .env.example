# Shared environment variables for this repo. No real secrets belong in
# this file — copy it and fill in real values locally, never commit the copy.
#
# Where each component actually reads its .env from (they're separate —
# copying this file to ONE location does not cover both):
#   - anaphora_backend/  reads the .env at the REPO ROOT (this file's
#     location) — see anaphora_backend/app/config.py. Usage:
#       cp .env.example .env
#   - dashboard/         reads its OWN .env inside dashboard/ — see
#     dashboard/dashboard_api.py. Usage:
#       cp .env.example dashboard/.env
#   - frontend/          does not use a .env for anything secret; see
#     frontend/.env.example for its one (non-secret) build-time setting.

# Required by anaphora_backend (all three LLM call sites: the conversation,
# Blueprint extraction, and Discovery insight synthesis) and by
# dashboard/dashboard_api.py's /api/ask fallback.
OPENAI_API_KEY=sk-...

# Optional — anaphora_backend only. Defaults to a local SQLite file
# (anaphora_backend/anaphora.db) if unset, which is enough to run the app
# with zero setup. Set this to a real Postgres connection string (e.g. a
# Render Postgres instance) for anything beyond local development.
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Optional — turns on LangSmith tracing for every LangChain call in
# anaphora_backend (conversation, extraction, Discovery insight). See
# https://smith.langchain.com to create a project and get an API key.
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=anaphora-mvp
